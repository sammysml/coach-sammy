{
  "expo": {
    "name": "Coach Sammy",
    "slug": "coachsammy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "coachsammy",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coachsammy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Coach Sammy uses the camera to scan food barcodes and take progress photos.",
        "NSPhotoLibraryUsageDescription": "Coach Sammy needs photo library access to upload progress photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "package": "com.coachsammy.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Allow Coach Sammy to access the camera to scan food barcodes." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Allow Coach Sammy to access your photos to upload progress images." }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notif-icon.png",
          "color": "#C9A84C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": { "origin": false }
    }
  }
}
